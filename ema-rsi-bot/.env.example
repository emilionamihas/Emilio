# Credenciales de Binance (solo necesarias si DRY_RUN=false o para testnet real)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Modo de operación
DRY_RUN=true
USE_TESTNET=true

# Mercado
SYMBOL=BTC/USDT
TIMEFRAME=4h

# Estrategia: cruce de medias EMA
EMA_FAST=20
EMA_SLOW=50

# Filtro RSI
RSI_PERIOD=14
RSI_LONG_MIN=45
RSI_LONG_MAX=70

# Filtro MACD (confirmación adicional, opcional)
USE_MACD_FILTER=true
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Stop-Loss / Take-Profit dinámicos (basados en ATR)
ATR_PERIOD=14
ATR_SL_MULT=2.0
REWARD_RISK_RATIO=2.0

# Gestión de riesgo
TOTAL_CAPITAL_USDT=1000
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT=0.02
DAILY_LOSS_LIMIT_PCT=0.05

# Costos de ejecución (para backtest y estimación de sizing)
TAKER_FEE_RATE=0.001
SLIPPAGE_BPS=5

# Backtesting
BACKTEST_DAYS=730

# Loop en vivo
POLL_INTERVAL_SECONDS=60
