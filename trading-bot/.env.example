# Copiar este archivo a ".env" y completar con tus credenciales.
# NUNCA subir el archivo ".env" real a git (ya está en .gitignore).

# --- Credenciales de Binance ---
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui

# --- Modo de operación ---
# DRY_RUN=true  -> paper trading: calcula señales y PnL simulado, NO manda órdenes reales.
# DRY_RUN=false -> manda órdenes reales a Binance (requiere USE_TESTNET=false y API keys con permiso de trading).
DRY_RUN=true

# USE_TESTNET=true -> usa el testnet de Binance (spot-testnet.binance.vision) en vez de producción.
USE_TESTNET=true

# --- Par estadístico a operar ---
SYMBOL_A=BTC/USDT
SYMBOL_B=ETH/USDT

# --- Calibración de cointegración (datos históricos vía REST) ---
TIMEFRAME=1h
LOOKBACK_CANDLES=500
MIN_COINTEGRATION_PVALUE=0.05
RECALIBRATION_INTERVAL_SECONDS=21600

# --- Z-Score (spread en tiempo real vía WebSocket) ---
ZSCORE_WINDOW=60
ZSCORE_ENTRY=2.0
ZSCORE_EXIT=0.5

# --- Costos de ejecución (deben reflejar tu nivel de fees real en Binance) ---
TAKER_FEE_RATE=0.001
MAKER_FEE_RATE=0.001
SLIPPAGE_BPS=5

# --- Gestión de riesgo ---
STOP_LOSS_PCT=0.01
MAX_CAPITAL_PER_TRADE_PCT=0.10
TOTAL_CAPITAL_USDT=1000

# --- Reporte ---
REPORT_INTERVAL_SECONDS=15
